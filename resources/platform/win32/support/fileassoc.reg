Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes]

[HKEY_CURRENT_USER\Software\Classes\.bpmn]
@="CadenzaFlowModeler.BPMN"

[HKEY_CURRENT_USER\Software\Classes\.dmn]
@="CadenzaFlowModeler.DMN"

[HKEY_CURRENT_USER\Software\Classes\.form]
@="CadenzaFlowModeler.FORM"

[HKEY_CURRENT_USER\Software\Classes\.rpa]
@="CadenzaFlowModeler.RPA"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.BPMN]
@="BPMN file"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.BPMN\DefaultIcon]
@="__CWD__,0"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.BPMN\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.BPMN\shell\open]
@="Open with CadenzaFlow Modeler"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.BPMN\shell\open\command]
@="__CWD__ \"%1\""

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.DMN]
@="DMN file"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.DMN\DefaultIcon]
@="__CWD__,0"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.DMN\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.DMN\shell\open]
@="Open with CadenzaFlow Modeler"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.DMN\shell\open\command]
@="__CWD__ \"%1\""

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.FORM]
@="FORM file"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.FORM\DefaultIcon]
@="__CWD__,0"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.FORM\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.FORM\shell\open]
@="Open with CadenzaFlow Modeler"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.FORM\shell\open\command]
@="__CWD__ \"%1\""

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.RPA]
@="RPA file"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.RPA\DefaultIcon]
@="__CWD__,0"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.RPA\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.RPA\shell\open]
@="Open with CadenzaFlow Modeler"

[HKEY_CURRENT_USER\Software\Classes\CadenzaFlowModeler.RPA\shell\open\command]
@="__CWD__ \"%1\""

