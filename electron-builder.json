{
  "appId": "com.cadenzaflow.CadenzaFlowModeler",
  "productName": "CadenzaFlow Modeler",
  "files": [
    {
      "filter": [
        "**",
        "!**/__tests__",
        "!test",
        "!dev.js"
      ]
    }
  ],
  "afterPack": "./tasks/after-pack.js",
  "afterSign": "./tasks/after-sign.mjs",
  "win": {
    "icon": "resources/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CadenzaFlow Modeler"
  },
  "linux": {
    "executableName": "cadenzaflow-modeler",
    "category": "Development",
    "target": [
      {
        "target": "tar.gz",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "icon": "resources/icon.png",
    "hardenedRuntime": true,
    "entitlements": "./build/entitlements.mac.inherit.plist",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ]
  },
  "fileAssociations": [
    {
      "ext": "bpmn",
      "name": "CadenzaFlowModeler.BPMN",
      "description": "BPMN file",
      "role": "Editor",
      "mimeType": "application/bpmn"
    },
    {
      "ext": "dmn",
      "name": "CadenzaFlowModeler.DMN",
      "description": "DMN file",
      "role": "Editor",
      "mimeType": "application/dmn"
    },
    {
      "ext": "form",
      "name": "CadenzaFlowModeler.FORM",
      "description": "FORM file",
      "role": "Editor",
      "mimeType": "application/camunda-form"
    }
  ]
}